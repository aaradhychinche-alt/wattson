# ---------------------------------------------------------------------------
# WATTSON configuration. Copy to .env and replace every placeholder.
# Never commit .env. WATTSON_API_TOKEN is the only credential the API accepts.
# ---------------------------------------------------------------------------

# Required for every write request (Bearer header). Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(36))"
WATTSON_API_TOKEN=replace-me-with-a-long-random-token

# SQLite by default. PostgreSQL example:
# WATTSON_DATABASE_URL=postgresql+psycopg://wattson:wattson@localhost:5432/wattson
WATTSON_DATABASE_URL=sqlite:///./.data/wattson.db

# Global infrastructure kill switch. "1"/"true" blocks all new launches.
WATTSON_KILL_SWITCH=0

# Provider: simulator (default, no credentials) or jarvislabs (real, paid).
WATTSON_PROVIDER=simulator

# Temporal
WATTSON_TEMPORAL_HOST=localhost:7233
WATTSON_TEMPORAL_NAMESPACE=default
WATTSON_TEMPORAL_TASK_QUEUE=wattson
WATTSON_APPROVAL_TIMEOUT_SECONDS=900

# API / dashboard
WATTSON_API_URL=http://localhost:8000
WATTSON_CORS_ORIGINS=http://localhost:3000

# --- Gemma (optional) -------------------------------------------------------
# ai_provider: none | ollama | hosted
#   none     -> deterministic analysis only (always available)
#   ollama   -> local open-weight Gemma through Ollama
#   hosted   -> Google Gemini API hosted Gemma
# GEMMA_MODEL is required when ai_provider is not none.
# Verified values (2026-10-25):
#   Ollama:  gemma4:e2b | gemma4:e4b | gemma4:12b | gemma4:26b | gemma4:31b
#   Hosted:  gemma-4-26b-a4b-it | gemma-4-31b-it
WATTSON_AI_PROVIDER=none
GEMMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
HOSTED_GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta
HOSTED_GEMMA_API_KEY=

# --- JarvisLabs (optional, paid) -------------------------------------------
# The adapter uses the official `jarvislabs` Python SDK (install: uv sync --extra jarvis).
# Without a token it is shown as "disconnected" and never called.
JL_API_KEY=

# --- Kepler (optional, real energy telemetry) -------------------------------
# Kepler is a Prometheus exporter. WATTSON reads documented Kepler metrics from
# a Prometheus-compatible endpoint. Disconnected by default; energy is simulated.
WATTSON_KEPLER_PROMETHEUS_URL=
WATTSON_KEPLER_POD_LABEL=
